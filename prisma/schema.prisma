generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./store.db"
}

model User {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  email     String    @unique
  firstName String
  lastName  String
  bio       String?
  birthday  DateTime?
  gender    String?
  avatar    String?
  address   String?
  password  Password?
}

model Signalwhale {
  id              Int      @id @default(autoincrement())
  address           String

  alert           String
  chain           String
  swapped         String
  from            String
  to              String
  netWorth        String
  transactionHash String
  time            DateTime @default(now())
}

model Signaltrader {
  id              Int      @id @default(autoincrement())
  address           String

  alert           String
  chain           String
  swapped         String
  from            String
  to              String
  netWorth        String
  transactionHash String
  time            DateTime @default(now())
}

model Password {
  id     String @id @default(uuid())
  salt   String
  hash   String
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])
}
